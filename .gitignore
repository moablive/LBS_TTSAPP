# Segredos: valor real so no .env local; o repo versiona apenas o exemplo
# `.env.*` (e nao so `.env.local`) porque backup tipo `.env.bak.20260827-...`
# tambem carrega o token do bot. Mesmo bloco dos outros tres apps da suite.
.env
.env.*
!.env.example

# Runtime
tmp/
data/
*.mp3
*.log
*.pid

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Node / JS Build
node_modules/
dist/
build/

# Claude Code — config local; ja vazou segredos via permissions.allow
.claude/settings.local.json
**/.claude/settings.local.json

# Store local do pnpm: e cache de pacote, nao codigo. Versionado, ele trouxe
# ~20k arquivos de terceiros para dentro do repositorio — inclusive README e
# fixture de pacote com chave de exemplo, que o gitleaks acusa como vazamento a
# cada varredura, escondendo achado de verdade no meio do ruido.
.pnpm-store/

