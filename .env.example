# =============================================================================
# LBSTTSAPP — .env ESPECÍFICO. A infra comum vem de ../shared.env.
# Subir: docker compose --env-file ../shared.env --env-file .env up -d --build
#
# Herdado do shared.env (NÃO repetir aqui):
#   OLLAMA_URL / OLLAMA_BASE_URL, OLLAMA_TEXT_MODEL, OLLAMA_KEEP_ALIVE
# =============================================================================

# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN='seu_token_aqui'

# ── IA ──────────────────────────────────────────────────────────────────────
# Modelo de VISÃO (OCR de imagem). OLLAMA_MODEL fica de propósito fora do
# shared.env — cada app escolhe o seu (o MoneyAPP usa outro modelo de visão).
OLLAMA_MODEL='qwen2.5vl:7b'
# Segundos até desistir de uma chamada ao Ollama. OCR de imagem grande e
# tradução de PDF são as chamadas lentas; 240s cobre com folga na 3060.
OLLAMA_TIMEOUT=240

# ── Padrões de leitura (cada usuário sobrescreve pelo bot) ──────────────────
# Código do catálogo em apps/bot/src/languages.py.
DEFAULT_TARGET_LANG='pt-BR'
DEFAULT_GENDER='female'
DEFAULT_SPEED='medium'

# ── Limites ─────────────────────────────────────────────────────────────────
MAX_INPUT_CHARS=20000
# A Bot API não deixa baixar arquivo acima de 20MB — não aumente.
MAX_FILE_MB=20
# Documento com até esse tamanho é lido inteiro de uma vez; acima disso o bot
# entrega seção por seção com os botões de navegação.
AUTOPLAY_MAX_CHARS=1200

# ── LoginHUB ────────────────────────────────────────────────────────────────
VITE_LOGINHUB_API_URL='https://loginhub.astralwavelabel.com/api'
VITE_LOGINHUB_APP_ID=13
APP_ID=13
JWT_SECRET='secret_local'

# --- Backend / banco / bot (faltavam neste exemplo) ---
BACKEND_API_URL='http://lbs_ttsapp_backend:3000/api/v1'
DB_NAME='lbsttsapp'
TELEGRAM_BOT_USERNAME=

# ==========================================
# VERSÃO DO BUILD (gerado por scripts/bump-version.mjs — não editar à mão)
# ==========================================
APP_VERSION=0.0.0
APP_BUILD_DATE=

# Abaixo deste tempo o /process nao notifica — avisar sobre um trabalho de
# 3s e ruido, a pessoa esta olhando para a tela quando ele termina.
TTS_NOTIFY_MIN_MS='20000'

# --- Web Push proprio (VAPID) -------------------------------------------
# Gere o par com:  npx web-push generate-vapid-keys
# Sem as duas chaves o backend responde 503 em /api/v1/push/* e a interface
# nao oferece o botao — falha explicita, nunca um botao que nao registra nada.
# Trocar o par INVALIDA as inscricoes ja feitas: os aparelhos seguem inscritos
# com a chave velha e param de receber sem dar erro.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato exigido pelo protocolo; o servidor de push usa em caso de problema.
VAPID_SUBJECT=

# Meu Bruxo — o bot deste app responde pelo @MeuBruxoBot (TELEGRAM_BOT_TOKEN e
# TELEGRAM_BOT_USERNAME sao os do Meu Bruxo). Prefixo do deep link de vinculo,
# que diz ao hub de que app e o passe. O MEUBRUXO_GATEWAY_SECRET vem do ../shared.env;
# sem ele o bot volta a fazer polling sozinho.
TELEGRAM_START_PREFIX=
